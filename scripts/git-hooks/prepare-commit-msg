#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# Vigil DCO sign-off hook.
#
# Enable once per clone (same setting the pre-push guard uses):
#
#     git config core.hooksPath scripts/git-hooks
#
# Why this exists
# ───────────────
# A release is gated on the tagged commit carrying a `Signed-off-by:` trailer
# (see CONTRIBUTING.md § Sign-off). That gate is an attestation under the
# Developer Certificate of Origin: the committer asserts they have the right
# to submit the work under the project's license.
#
# Relying on remembering `git commit -s` makes the attestation a matter of
# habit, and a gate that fails only at release time -- long after the commit
# it is complaining about -- is a gate that gets skipped rather than fixed.
# Adding the trailer at commit time means the claim is recorded when the
# author is present to make it.
#
# This appends the trailer for the identity git is already committing as. It
# does not forge a sign-off for anyone else: the name and email are exactly
# what `git config user.name` / `user.email` resolve to, which is the same
# identity recorded as the commit author.
#
# Escape hatch: `git commit --no-verify` does NOT skip this hook -- that flag
# bypasses only `pre-commit` and `commit-msg`. To commit without a sign-off,
# disable hooks for the single command:
#
#     git -c core.hooksPath=/dev/null commit ...

set -eu

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=${2:-}

# A message that already carries a sign-off is left alone. This covers
# `git commit -s`, `--amend` on an already-signed commit, cherry-picks, and
# reverts, none of which should gain a duplicate trailer.
if grep -qiE '^[[:space:]]*Signed-off-by:[[:space:]]' "$COMMIT_MSG_FILE"; then
    exit 0
fi

# A merge commit's message is generated by git and carries no authorship
# claim of its own; the sign-offs that matter are on the commits being
# merged.
if [ "$COMMIT_SOURCE" = "merge" ]; then
    exit 0
fi

name=$(git config user.name || true)
email=$(git config user.email || true)

# Fail loudly rather than writing a malformed trailer. An empty identity
# would produce `Signed-off-by:  <>`, which satisfies a naive grep while
# attesting nothing -- the exact shape of failure this project treats as
# worse than an honest error.
if [ -z "$name" ] || [ -z "$email" ]; then
    printf 'vigil: cannot add Signed-off-by: git user.name or user.email is unset.\n' >&2
    printf '       Set them, or skip this hook for one command with:\n' >&2
    printf '           git -c core.hooksPath=/dev/null commit ...\n' >&2
    exit 1
fi

# `git interpret-trailers` places the trailer in the message's trailer block
# rather than blindly appending, so it lands correctly whether or not the
# message already ends in trailers.
git interpret-trailers \
    --if-exists doNothing \
    --trailer "Signed-off-by: $name <$email>" \
    --in-place "$COMMIT_MSG_FILE"
