[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/bin/*
Target = usr/sbin/*
Target = usr/lib/*
Target = etc/*
Target = boot/*

[Action]
Description = Vigil Baseline: entering maintenance window...
When = PreTransaction
Exec = /bin/sh -c 'VIGIL=/usr/bin/vigil; if [ -x "$VIGIL" ]; then seal_out=$("$VIGIL" maintenance enter --quiet --seal 2>&1) || true; if [ -n "$seal_out" ]; then printf "%s\n" "$seal_out" | while IFS= read -r l; do [ -n "$l" ] && logger -t vigil-pacman "$l"; done; fi; if printf "%s\n" "$seal_out" | grep -q "VIGIL PRE-UPDATE DEVIATIONS"; then summary=$(printf "%s\n" "$seal_out" | sed -n "s/^VIGIL PRE-UPDATE DEVIATIONS: \([0-9]*\).*\$/\1/p" | head -n 1); notify-send -u critical "Vigil" "${summary:-Some} file(s) were already deviating BEFORE this update started. Run: vigil audit show --since 5m" 2>/dev/null; fi; exit 0; fi; if systemctl is-active --quiet vigild 2>/dev/null; then logger -p daemon.err -t vigil-pacman "vigild is running but $VIGIL is missing; maintenance window NOT entered. The post-hook will fail and Vigil will report inconsistent state. Reinstall vigil-baseline as soon as the transaction completes."; notify-send -u critical "Vigil" "vigild is running but the vigil binary is missing. Reinstall vigil-baseline." 2>/dev/null; fi; exit 0'
